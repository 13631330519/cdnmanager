# 复制到 /etc/cdnmanager/cdnmanager.env 后按需修改

# 应用密钥（生产环境务必修改）
SECRET_KEY=change-me-to-a-random-string
EXTERNAL_API_SECRET=change-me-external-secret

# 数据目录（SQLite 数据库路径，所有 worker 共享此目录）
DATA_DIR=/var/lib/cdnmanager
DATABASE_FILE=/var/lib/cdnmanager/cdn_manager.db

# Gunicorn：建议只监听本机，由 Nginx 反代对外暴露 80/443
GUNICORN_BIND=127.0.0.1:8080
GUNICORN_WORKERS=4
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120

# 后台任务轮询（多 worker 时由 SQLite 租约锁保证单实例执行）
ENABLE_TASK_POLLING=true

# Session 有效期（小时）
SESSION_HOURS=10
